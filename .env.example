# KaanViz Environment Configuration Template
# Copy to '.env' for local development or VPS deployment.
# NEVER commit your populated '.env' file containing real secret passwords or API keys.

# ==================================================
# 1. PUBLIC CONFIGURATION (Safe for build/environment)
# ==================================================

# Core Application State
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Caddy & Production Domains (Used by Caddyfile & Docker Compose Production)
FRONTEND_DOMAIN=analytics.yourdomain.com
API_DOMAIN=api.yourdomain.com

# Public API URL (Baked into Frontend Browser JS at Build Time)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1

# CORS Allowed Origins (Comma-separated list or JSON array)
CORS_ORIGINS=https://analytics.yourdomain.com

# Local Ports (Development default overrides)
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5433
REDIS_PORT=6380

# Storage Base Directory
STORAGE_BASE_PATH=./storage
STORAGE_RAW_PATH=./storage/raw
STORAGE_PROCESSED_PATH=./storage/processed
STORAGE_METADATA_PATH=./storage/metadata
STORAGE_EXPORTS_PATH=./storage/exports

# AI General Configuration
AI_ENABLED=true
AI_PROVIDER=nvidia
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# ==================================================
# 2. SECRET CONFIGURATION (Backend Only — NEVER expose to browser)
# ==================================================

# PostgreSQL Database Credentials
POSTGRES_USER=kaanviz
POSTGRES_PASSWORD=your_strong_random_database_password_here
POSTGRES_DB=kaanviz_db
DATABASE_URL=postgresql+psycopg2://kaanviz:your_strong_random_database_password_here@postgres:5432/kaanviz_db

# Redis Connection URL
REDIS_URL=redis://redis:6379/0

# NVIDIA Nemotron LLM API Key (Backend-only)
NVIDIA_API_KEY=your_nvidia_api_key_here
