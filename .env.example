# KaanViz Environment Configuration Template

# Core Application
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# URLs & Ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:3000

# PostgreSQL Configuration
POSTGRES_USER=kaanviz
POSTGRES_PASSWORD=kaanviz_dev_password
POSTGRES_DB=kaanviz_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg2://kaanviz:kaanviz_dev_password@localhost:5433/kaanviz_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# Storage Locations (Relative or Absolute)
STORAGE_BASE_PATH=./storage
STORAGE_RAW_PATH=./storage/raw
STORAGE_PROCESSED_PATH=./storage/processed
STORAGE_METADATA_PATH=./storage/metadata
STORAGE_EXPORTS_PATH=./storage/exports

# AI Configuration
AI_ENABLED=true
AI_PROVIDER=nvidia

# NVIDIA Nemotron
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
